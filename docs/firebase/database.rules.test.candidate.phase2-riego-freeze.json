{
  "rules": {
    "lasala-users-v1": {
      ".read": false,
      ".write": false
    },
    "lasala-roles-v1": {
      ".read": "auth != null && auth.token.appUser != null",
      ".write": false
    },
    "lasala-admin-audit-v1": {
      ".read": false,
      ".write": false
    },
    "lasala-config-infra-v1": {
      ".read": false,
      ".write": false
    },
    "lasala-qc-mediciones-v1": {
      ".read": false,
      ".write": false
    },
    "lasala-qc-fotos-sharepoint-v1": {
      ".read": false,
      ".write": false
    },
    "lasala-avisos-v2": {
      ".read": false,
      ".write": false
    },
    "lasala-push-subs-v2": {
      ".read": false,
      ".write": false
    },
    "lasala-push-endpoints-v2": {
      ".read": false,
      ".write": false
    },
    "lasala-push-outbox-v2": {
      ".read": false,
      ".write": false
    },
    "lasala-push-weekly-v2": {
      ".read": false,
      ".write": false
    },
    "lasala-push-nonces-v2": {
      ".read": false,
      ".write": false
    },
    "$other": {
      ".read": "auth != null && auth.token.appUser != null",
      ".write": "auth != null && auth.token.appUser != null && (!$other.matches(/^lasala-riego-v2-/) || ($other !== 'lasala-riego-v2-index' && root.child('lasala-riego-write-locks-v3').child($other).val() === 'open')) && !$other.matches(/^lasala-riego-(v1|sync-v1|ejecutado-v1|offline-v1)$/) && $other !== 'lasala-propuestas-riego-v1'"
    },
    "lasala-alert-event-sources-v2": {
      ".read": false,
      ".write": false
    },
    "lasala-invernaderos-catalog-v2": {
      ".read": false,
      ".write": false
    },
    "lasala-event-permissions-v2": {
      ".read": false,
      ".write": false
    },
    "lasala-alert-event-ledger-v2": {
      ".read": false,
      ".write": false
    },
    "lasala-riego-event-aggregate-demo-v2": {
      ".read": false,
      ".write": false
    },
    "lasala-riego-write-locks-v3": {
      ".read": false,
      ".write": false
    }
  }
}
